<UserControl x:Class="UniversalLauncher.SettingsDrawerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Settings24" FontSize="24" Margin="0,0,10,0" Foreground="White"/>
                <TextBlock Text="Settings" FontSize="20" FontWeight="Bold" Foreground="White"/>
            </StackPanel>

			<ui:Button
                Icon="{ui:SymbolIcon Dismiss24}"
                HorizontalAlignment="Right"
                Appearance="Transparent"
                Click="CloseSettings_Click"
                Cursor="Hand"/>
        </Grid>

        <StackPanel Grid.Row="1">

            <TextBlock Text="LIBRARY MANAGEMENT" FontWeight="SemiBold" FontSize="12" Foreground="Gray" Margin="0,0,0,10"/>

			<ui:Button
                Content="Add Game Manually"
                Icon="{ui:SymbolIcon Add24}"
                HorizontalAlignment="Stretch"
                Margin="0,0,0,10"
                Click="AddManualGameButton_Click"
                Appearance="Secondary"
                Cursor="Hand"/>

			<ui:Button
                Content="Scan Emulator Games"
                Icon="{ui:SymbolIcon Search24}"
                HorizontalAlignment="Stretch"
                Margin="0,0,0,10"
                Click="ScanEmulatorButton_Click"
                Appearance="Secondary"
                Cursor="Hand"/>

			<ui:Button
                x:Name="BtnDrawerSync"
                Content="Library Sync"
                Icon="{ui:SymbolIcon ArrowSync24}"
                HorizontalAlignment="Stretch"
                Margin="0,0,0,25"
                Click="DrawerSyncButton_Click"
                Appearance="Secondary"
                Cursor="Hand"/>

        </StackPanel>
    </Grid>
</UserControl>